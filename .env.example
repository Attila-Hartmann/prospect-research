# Required: Google Maps Platform API key
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required: Path to Google credentials JSON file
# Can be a Service Account key or OAuth2 client_secret JSON
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Optional: PageSpeed Insights API key (raises rate limit beyond 1 req/sec)
# Enable "PageSpeed Insights API" in Google Cloud Console
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Optional: Your Google email — auto-shares the created Sheet with you
USER_EMAIL=you@gmail.com

# ---------------------------------------------------------------------------
# Outreach (outreach_select.py / outreach_publish.py) — cold-email the grade-A,
# no-website prospects with a personalized sample landing page.
# ---------------------------------------------------------------------------

# Gmail account that drafts/sends outreach (From: header + "me" in the API).
GMAIL_ADDRESS=hartmann.attila88@gmail.com

# Delivery uses the Gmail REST API over HTTPS (the cloud blocks IMAP/SMTP ports,
# and a service account can't act on a personal Gmail). Authenticate with the
# USER's own OAuth refresh token. Create it once with scripts/mint_gmail_token.py
# (needs the Gmail API enabled + a Desktop-app OAuth client; set the consent
# screen to "In production" so the refresh token doesn't expire). The file holds
# {client_id, client_secret, refresh_token, token_uri}.
GMAIL_OAUTH_FILE=gmail_oauth.json

# draft = create Gmail drafts for manual review (IMAP); auto = send via SMTP.
SEND_MODE=draft

# Safety override: when set, ALL drafts/sends go to this address instead of the
# real prospect (the intended address is shown in the subject + sheet). Leave
# empty only when you are ready to reach real prospects.
TEST_RECIPIENT=hartmann.attila88@gmail.com

# Max drafts/sends per run (deliverability + review-load cap).
DAILY_CAP=25

# Persistent prospect sheet name (must match the discovery routine).
SHEET_NAME=Hungary Web Prospects

# GitHub Pages repo that hosts the generated sample pages (default publish target).
# Never embed a token in the URL. In cloud routines the push is authorised by the
# routine's GitHub connection (attach attila-landing-samples as a routine source);
# locally, your normal git credentials are used. PAGES_BASE_URL is the public URL.
PAGES_REPO_URL=https://github.com/Attila-Hartmann/attila-landing-samples.git
PAGES_BASE_URL=https://attila-hartmann.github.io/attila-landing-samples

# Optional fallback: upload pages to this public GCS bucket instead of GitHub Pages.
GCS_BUCKET=

# Cloud routines: secrets are NOT written into routine prompts. They live as
# environment variables of the claude.ai cloud environment "prospect-pipeline":
#   GCP_SA_JSON_B64       base64 of service_account.json
#   GMAIL_OAUTH_JSON_B64  base64 of gmail_oauth.json
#   GOOGLE_MAPS_API_KEY, PAGESPEED_API_KEY
# and the routine prompt decodes them into the files above at the start of each run.
