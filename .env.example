# Required: Google Maps Platform API key
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required: Path to Google credentials JSON file
# Can be a Service Account key or OAuth2 client_secret JSON
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Optional: PageSpeed Insights API key (raises rate limit beyond 1 req/sec)
# Enable "PageSpeed Insights API" in Google Cloud Console
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Optional: Your Google email — auto-shares the created Sheet with you
USER_EMAIL=you@gmail.com
